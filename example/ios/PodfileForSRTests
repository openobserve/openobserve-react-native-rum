# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

use_modular_headers!

target 'ddSdkReactnativeExample' do
  native_ios_sdk_path = ENV['DD_NATIVE_IOS_SDK_PATH']
  if (native_ios_sdk_path) then
    pod 'OpenObserveCore', :path => "#{native_ios_sdk_path}/OpenObserveCore.podspec"
    pod 'OpenObserveLogs', :path => "#{native_ios_sdk_path}/OpenObserveLogs.podspec"
    pod 'OpenObserveTrace', :path => "#{native_ios_sdk_path}/OpenObserveTrace.podspec"
    pod 'OpenObserveInternal', :path => "#{native_ios_sdk_path}/OpenObserveInternal.podspec"
    pod 'OpenObserveRUM', :path => "#{native_ios_sdk_path}/OpenObserveRUM.podspec"
    pod 'OpenObserveCrashReporting', :path => "#{native_ios_sdk_path}/OpenObserveCrashReporting.podspec"
    pod 'OpenObserveWebViewTracking', :path => "#{native_ios_sdk_path}/OpenObserveWebViewTracking.podspec"
    pod 'OpenObserveSessionReplay', :path => "#{native_ios_sdk_path}/OpenObserveSessionReplay.podspec"
  end

  pod 'OpenObserveSDKReactNative', :path => '../../packages/core/OpenObserveSDKReactNative.podspec', :testspecs => ['Tests']
  pod 'OpenObserveSDKReactNativeSessionReplay', :path => '../../packages/react-native-session-replay/OpenObserveSDKReactNativeSessionReplay.podspec', :testspecs => ['Tests']

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
      # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    # Enable `DD_SDK_COMPILED_FOR_TESTING` condition when compiling `OpenObserveSDK` dependency:
    datadog_sdk_target = installer.pods_project.targets.detect {|t| ["OpenObserveCore", "OpenObserveRUM", "OpenObserveLogs", "OpenObserveInternal", "OpenObserveTrace", "OpenObserveCrashReporting"].include?(t.name) }
    datadog_sdk_target.build_configurations.each do |config|
      config.build_settings['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] = '$(inherited) DD_SDK_COMPILED_FOR_TESTING'
    end    
  end
end
